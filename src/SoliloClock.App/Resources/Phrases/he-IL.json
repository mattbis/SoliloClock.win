{
  "locale": "he-IL",
  "phrases": [
    { "id": "computer.001", "text": "עוד רבע שעה הושלמה בהצלחה. שלא כמו הפרויקט שלך.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.002", "text": "המהדר שלך שולח דרישת שלום. בעיקר אזהרות.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.003", "text": "הזמן עף. מערכת הבנייה שלך מעדיפה ללכת.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.004", "text": "איפשהו, נקודה-פסיק הורס למישהו את הצהריים.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.005", "text": "פתוחים לך שבעה עשר כרטיסיות ולחלוטין אין תשובות.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.006", "text": "הבאג קודם לתכונה. מזל טוב.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.007", "text": "המעבד שלך מאמין בך. הזיכרון שלך מודאג.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.008", "text": "יום נחמד למחוק מטמון ולהעמיד פנים שזה עזר.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.009", "text": "הקוד עובד. בבקשה אל תיגע בכלום.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.010", "text": "ניסית לכבות ולהדליק את הציפיות שלך?", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.011", "text": "את האזהרה האחרונה לא מתקנים סתם כך.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.012", "text": "רשימת ה-TODO שלך ביקשה רשימת TODO משל עצמה.", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.013", "text": "התיעוד מדויק ביקום מקביל.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.014", "text": "עוד שעה, עוד תלות מסתורית.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.015", "text": "בנייה נקייה היא דבר יפה וחשוד.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.016", "text": "הטרמינל שלך ראה דברים שאי אפשר לשכוח.", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.017", "text": "תחזית להיום: חריגים מפוזרים עם סיכוי לחזרה לאחור.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.018", "text": "אתה יכול לסגור כרטיסייה אחת. כפינוק.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.019", "text": "הדיבאגר לא שופט אותך. כנראה.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.020", "text": "העצמי העתידי שלך הגיש תלונה על הקיצור הזה.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.021", "text": "Git זוכר. Git תמיד זוכר.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.022", "text": "איפשהו במאגר הזה יש פונקציה בשם final_final.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.023", "text": "הבדיקות ירוקות. ירוקות באופן חשוד.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.024", "text": "מאוורר המחשב שלך מלחין ג'אז ניסיוני.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.025", "text": "שקלת לכתוב פחות קבצי תצורה? גם אנחנו לא.", "category": "computer", "tone": "cheeky", "weight": 4 },

    { "id": "break.026", "text": "אתה בזה שלוש שעות. העולם בחוץ רוצה מילה.", "category": "break", "tone": "cheeky", "weight": 3, "minActiveMinutes": 180 },
    { "id": "break.027", "text": "הכיסא שלך כבר נהנה מספיק מהחברה שלך.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.028", "text": "השמיים עדיין זמינים בלי מנוי.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.029", "text": "לך לבדוק עץ. בלי דיבאגר.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.030", "text": "העיניים שלך ביקשו חלון תחזוקה.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.031", "text": "הליכה קצרה עשויה לפתור תלויות במוח שלך.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.032", "text": "הדשא לא עודכן, אבל עדיין שווה לגעת בו.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.033", "text": "מים: תוסף הפרודוקטיביות המקורי.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.034", "text": "תתמתח. גם למחסנית שלך יש גבולות.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.035", "text": "מותר לך להשאיר את המחשב לבד. הוא יסתדר.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.036", "text": "קפה אינו תחליף לאור יום.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.037", "text": "תזכורת ידידותית: לברכיים יש מטרה.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.038", "text": "תתרחק מהמסך. הפיקסלים יישארו נאמנים.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.039", "text": "לאוויר צח יש תאימות לאחור מצוינת.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.040", "text": "המקלדת שלך מציעה פרידה קצרה.", "category": "break", "tone": "polite", "weight": 3 },

    { "id": "morning.041", "text": "בוקר טוב. הבאגים ערים כבר שעות.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.042", "text": "קום וזרח. או קום ותנהל משא ומתן.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.043", "text": "ארוחת בוקר אינה תלות אופציונלית.", "category": "morning", "tone": "polite", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.044", "text": "היום צעיר. תיבת הדואר שלך עתיקה.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.045", "text": "הקפה הצטרף לשיחה.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },

    { "id": "afternoon.046", "text": "כמעט צהריים. אפילו השעון נראה רעב.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.047", "text": "הצהריים הגיעו בלי הערות שחרור שימושיות.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.048", "text": "עוד בוקר פרודוקטיבי של הזזת חלונות.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.049", "text": "היומן אומר פגישה. הנשמה אומרת ממש לא.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.050", "text": "השמש עושה כמיטב יכולתה. כדאי להצטרף.", "category": "afternoon", "tone": "polite", "weight": 3, "timeWindow": "afternoon" },

    { "id": "evening.051", "text": "משמרת הצהריים מפוקחת כעת על ידי שעון.", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.052", "text": "עוד יום של התקדמות הרואית והחלטות מוטלות בספק.", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.053", "text": "מאוחר. העצמי העתידי שלך יעריך שינה.", "category": "evening", "tone": "polite", "weight": 3, "timeWindow": "evening" },

    { "id": "late-night.054", "text": "הירח דיווח. אתה דיווחת יציאה?", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.055", "text": "חצות: כשכל רעיון נשמע כמו סטארטאפ.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.056", "text": "הכרית שלך פתחה קריאת תמיכה.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.057", "text": "זו השעה שבה שמות משתנים הופכים לשירה.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.058", "text": "הלילה שקט. חוץ מהמאוורר שלך.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.059", "text": "הקוד שלך יכול לחכות לבוקר. הבאגים לא הולכים לשום מקום.", "category": "late-night", "tone": "polite", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.060", "text": "מחר הזדמנות נוספת לשנות את השם של הכל.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },

    { "id": "fortune.061", "text": "פס התקדמות נצפה לעולם לא מודה בתבוסה.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.062", "text": "היזהר מחוכמת השעונים: הם תמיד סומכים על משהו.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.063", "text": "מתכנת חכם יודע מתי לעצור. אגדי מחזיק טיימר.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.064", "text": "זמן הוא כסף, אבל השעון הזה לא מקבל אף אחד מהם.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.065", "text": "היקום מתרחב. גם תיקיית ההורדות שלך.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.066", "text": "אל תתווכח עם שעון. יש לו כל הזמן שבעולם.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.067", "text": "אם החיים נותנים לך לימונים, בדוק את סכום הביקורת של החבילה.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.068", "text": "הגורל שלך מעובד. בבקשה אל תרענן.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.069", "text": "תיבת דואר ריקה היא מיתוס שמספרים למפתחים צעירים.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.070", "text": "סוד האושר נמצא איפשהו תחת הגדרות, מתקדם.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.071", "text": "כל המצאה גדולה התחילה במישהו שנמנע ממשימה אחרת.", "category": "fortune", "tone": "polite", "weight": 3 },
    { "id": "fortune.072", "text": "יש שני סוגי אנשים: אלה שעושים גיבוי, ואלה שיהיו סיפור אזהרה.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.073", "text": "אדם חכם שואל שאלות. אדם טיפש לוחץ על עדכן הכל.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.074", "text": "השעון יודע מה עשית בקיץ שעבר. כנראה דיבגת.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.075", "text": "איפשהו, שרת עתיק עדיין עובד מושלם. איש לא יודע למה.", "category": "fortune", "tone": "cheeky", "weight": 3 },

    { "id": "rare.076", "text": "שימו לב. העכבר שלכם נבחר למנהל הפרויקט.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.077", "text": "ההכרזה אושרה על ידי המועצה הבינלאומית לדקות.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.078", "text": "השעון החליט לפנות לקריירה בריקוד פרשני.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.079", "text": "נא להישאר רגועים. שנייה מדויקת באופן חריג מתקרבת.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.080", "text": "הדקה הבאה מובאת לכם על ידי הדקה הקודמת.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.081", "text": "ספרתי כל שנייה. חלקן היו מאכזבות מאוד.", "category": "rare", "tone": "unhinged", "weight": 1 },
    { "id": "rare.082", "text": "השולחן שלך ביקש הערכת ביצועים.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.083", "text": "מחוג השעות ומחוג הדקות כבר לא מדברים.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.084", "text": "רציתי לספר לך בדיחה על מסע בזמן, אבל לא אהבת אותה.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.085", "text": "ועדה קטנה של שעונים הצביעה לדחות את יום שלישי.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.086", "text": "השניות מתאגדות. צפו לעיכובים.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.087", "text": "פתחת את ההישג האגדי: עדיין יושב שם.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.088", "text": "לצערי, מחר לא בוטל.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.089", "text": "המושג דייקנות נמצא כעת בגרסת בטא.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.090", "text": "השעון רוצה להודות לך על כך שאתה ממשיך להתקיים.", "category": "rare", "tone": "cheeky", "weight": 1 },

    { "id": "computer.091", "text": "בהית במסך מספיק זמן כדי להפוך לטפט.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.092", "text": "עוד רבע שעה של העמדת פנים שזה התיקון האחרון.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.093", "text": "גרף הפרודוקטיביות שלך הוחלף במשיכת כתפיים.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.094", "text": "זה שעון, לא מאמן חיים. ובכל זאת, הנה אנחנו.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "computer.095", "text": "מותר לך להפסיק לייעל דברים שאיש לא ישים לב אליהם.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.096", "text": "אולי הבאג לא בקוד. אולי הבאג הוא הגורל.", "category": "fortune", "tone": "unhinged", "weight": 3 },
    { "id": "break.097", "text": "נראה שהתוכנית המבריקה שלך כוללת עוד קפה.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "computer.098", "text": "ניסית להסביר את הבעיה לברווז גומי עם ניסיון ניהולי?", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.099", "text": "עוד ריפקטור אחד והפרויקט עלול לפתח תודעה.", "category": "computer", "tone": "unhinged", "weight": 3 },
    { "id": "computer.100", "text": "עכשיו הזמן לשקול אם באמת היית צריך עוד תכונה.", "category": "computer", "tone": "cheeky", "weight": 3 }
  ]
}
