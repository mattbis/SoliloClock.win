{
  "locale": "ar",
  "phrases": [
    { "id": "computer.001", "text": "ربع ساعة آخر تمت ترجمته بنجاح. على عكس مشروعك.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.002", "text": "مترجمك يرسل تحياته. معظمها تحذيرات.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.003", "text": "الوقت يطير. نظام البناء لديك يفضّل المشي.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.004", "text": "في مكان ما، فاصلة منقوطة تفسد ظهيرة أحدهم.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.005", "text": "لديك سبعة عشر تبويبًا مفتوحًا ولا إجابة واحدة.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.006", "text": "تمت ترقية الخطأ إلى ميزة. مبروك.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.007", "text": "معالجك يؤمن بك. ذاكرتك لديها تحفظات.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.008", "text": "يوم جميل لمسح ذاكرة التخزين المؤقت والتظاهر بأنه ساعد.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.009", "text": "الشيفرة تعمل. من فضلك لا تلمس شيئًا.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.010", "text": "هل جربت إطفاء توقعاتك ثم تشغيلها مرة أخرى؟", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.011", "text": "آخر تحذير لا يُصلح ببساطة.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.012", "text": "قائمة مهامك طلبت قائمة مهام خاصة بها.", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.013", "text": "التوثيق دقيق في كون موازٍ.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.014", "text": "ساعة أخرى، تبعية غامضة أخرى.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.015", "text": "بناء نظيف شيء جميل ومريب.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.016", "text": "طرفيتك رأت أشياء لا يمكن أن تُنسى.", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.017", "text": "توقعات الطقس: استثناءات متفرقة مع احتمال تراجع.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.018", "text": "يمكنك إغلاق تبويب واحد. كمكافأة.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.019", "text": "المصحح لا يحكم عليك. على الأرجح.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.020", "text": "نسختك المستقبلية قدمت شكوى بشأن هذا الاختصار.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.021", "text": "Git يتذكر. Git يتذكر دائمًا.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.022", "text": "في مكان ما في هذا المستودع دالة تُسمى final_final.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.023", "text": "الاختبارات خضراء. خضراء بشكل مريب.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.024", "text": "مروحة حاسوبك تؤلف جازًا تجريبيًا.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.025", "text": "هل فكرت في كتابة ملفات إعداد أقل؟ ولا نحن.", "category": "computer", "tone": "cheeky", "weight": 4 },

    { "id": "break.026", "text": "أنت هنا منذ ثلاث ساعات. العالم الخارجي يريد كلمة.", "category": "break", "tone": "cheeky", "weight": 3, "minActiveMinutes": 180 },
    { "id": "break.027", "text": "كرسيك اكتفى من صحبتك.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.028", "text": "السماء ما زالت متاحة بدون اشتراك.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.029", "text": "اذهب وانظر إلى شجرة. بلا مصحح.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.030", "text": "عيناك طلبتا نافذة صيانة.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.031", "text": "نزهة قصيرة قد تحل تبعيات في رأسك.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.032", "text": "العشب لم يُحدَّث، لكنه ما زال يستحق اللمس.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.033", "text": "الماء: الملحق الأصلي للإنتاجية.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.034", "text": "تمدد. حتى مكدسك له حدود.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.035", "text": "يُسمح لك بترك الحاسوب وحده. سيتدبر أمره.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.036", "text": "القهوة ليست بديلًا عن ضوء النهار.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.037", "text": "تذكير ودود: للركب هدف.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.038", "text": "ابتعد عن الشاشة. البكسلات ستبقى مخلصة.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.039", "text": "الهواء النقي يتمتع بتوافق خلفي ممتاز.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.040", "text": "لوحة مفاتيحك تقترح انفصالًا قصيرًا.", "category": "break", "tone": "polite", "weight": 3 },

    { "id": "morning.041", "text": "صباح الخير. الأخطاء مستيقظة منذ ساعات.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.042", "text": "انهض وأشرق. أو انهض وتفاوض.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.043", "text": "الفطور ليس تبعية اختيارية.", "category": "morning", "tone": "polite", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.044", "text": "اليوم صغير. بريدك قديم.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.045", "text": "القهوة انضمت إلى المحادثة.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },

    { "id": "afternoon.046", "text": "اقترب وقت الغداء. حتى الساعة تبدو جائعة.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.047", "text": "وصلت الظهيرة بلا ملاحظات إصدار مفيدة.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.048", "text": "صباح منتج آخر في تحريك النوافذ.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.049", "text": "التقويم يقول اجتماع. الروح تقول مستحيل.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.050", "text": "الشمس تبذل جهدها. يمكنك الانضمام إليها.", "category": "afternoon", "tone": "polite", "weight": 3, "timeWindow": "afternoon" },

    { "id": "evening.051", "text": "وردية المساء يشرف عليها الآن ساعة.", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.052", "text": "يوم آخر من التقدم البطولي والقرارات المشكوك فيها.", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.053", "text": "الوقت يتأخر. نسختك المستقبلية ستقدر النوم.", "category": "evening", "tone": "polite", "weight": 3, "timeWindow": "evening" },

    { "id": "late-night.054", "text": "القمر سجّل حضوره. هل سجّلت خروجك؟", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.055", "text": "منتصف الليل: حين تبدو كل فكرة شركة ناشئة.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.056", "text": "وسادتك فتحت تذكرة دعم.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.057", "text": "في هذه الساعة تصبح أسماء المتغيرات شعرًا.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.058", "text": "الليل هادئ. إلا مروحة التبريد.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.059", "text": "الشيفرة يمكنها الانتظار حتى الصباح. الأخطاء لن تذهب بعيدًا.", "category": "late-night", "tone": "polite", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.060", "text": "غدًا فرصة أخرى لإعادة تسمية كل شيء.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },

    { "id": "fortune.061", "text": "شريط التقدم الذي تراقبه لا يعترف بالهزيمة أبدًا.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.062", "text": "احذر حكمة الساعات: إنها دائمًا تحسب شيئًا.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.063", "text": "المبرمج الحكيم يعرف متى يتوقف. الأسطوري لديه مؤقت.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.064", "text": "الوقت مال، لكن هذه الساعة لا تقبل أيًا منهما.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.065", "text": "الكون يتمدد. ومجلد التنزيلات أيضًا.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.066", "text": "لا تجادل ساعة. لديها وقت العالم كله.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.067", "text": "إن أعطتك الحياة ليمونًا، فتحقق من بصمة الحزمة.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.068", "text": "مصيرك قيد المعالجة. من فضلك لا تحدّث الصفحة.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.069", "text": "صندوق وارد فارغ أسطورة تُحكى للمبتدئين.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.070", "text": "سر السعادة في مكان ما تحت الإعدادات، متقدم.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.071", "text": "كل اختراع عظيم بدأ بشخص يتجنب مهمة أخرى.", "category": "fortune", "tone": "polite", "weight": 3 },
    { "id": "fortune.072", "text": "هناك نوعان من الناس: من يأخذون نسخًا احتياطية، ومن سيصبحون عبرة.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.073", "text": "الحكيم يسأل. الأحمق يضغط تحديث الكل.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.074", "text": "الساعة تعرف ما فعلته الصيف الماضي. على الأرجح كنت تصحح أخطاء.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.075", "text": "في مكان ما خادم قديم يعمل بشكل مثالي. لا أحد يعرف لماذا.", "category": "fortune", "tone": "cheeky", "weight": 3 },

    { "id": "rare.076", "text": "انتبه. تم انتخاب فأرتك مديرًا للمشروع.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.077", "text": "أُقر هذا الإعلان من المجلس الدولي للدقائق.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.078", "text": "قررت الساعة أن تمتهن الرقص التعبيري.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.079", "text": "ابقَ هادئًا. تقترب ثانية شديدة الدقة.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.080", "text": "الدقيقة القادمة مقدمة من الدقيقة السابقة.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.081", "text": "عددت كل ثانية. بعضها كان مخيبًا للغاية.", "category": "rare", "tone": "unhinged", "weight": 1 },
    { "id": "rare.082", "text": "مكتبك طلب تقييم أداء.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.083", "text": "عقرب الساعات وعقرب الدقائق لم يعودا يتحدثان.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.084", "text": "كنت سأروي نكتة عن السفر في الزمن، لكنها لم تعجبك.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.085", "text": "لجنة صغيرة من الساعات صوتت على تأجيل الثلاثاء.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.086", "text": "الثواني تشكّل نقابة. توقع تأخيرات.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.087", "text": "فتحت الإنجاز الأسطوري: ما زلت جالسًا هنا.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.088", "text": "يؤسفني إبلاغك أن الغد لم يُلغَ.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.089", "text": "مفهوم الدقة حاليًا في نسخة تجريبية.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.090", "text": "الساعة تشكرك على استمرار وجودك.", "category": "rare", "tone": "cheeky", "weight": 1 },

    { "id": "computer.091", "text": "تحدّق في الشاشة بما يكفي لتصبح خلفية سطح مكتب.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.092", "text": "خمس عشرة دقيقة أخرى من التظاهر بأن هذا الإصلاح الأخير.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.093", "text": "استُبدل رسم الإنتاجية لديك بهزّة كتف.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.094", "text": "هذه ساعة، لا مدرّب حياة. ومع ذلك.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "computer.095", "text": "لديك إذن بالتوقف عن تحسين أشياء لن يلاحظها أحد.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.096", "text": "ربما الخطأ ليس في الشيفرة. ربما الخطأ هو القدر.", "category": "fortune", "tone": "unhinged", "weight": 3 },
    { "id": "break.097", "text": "يبدو أن خطتك الرائعة تتضمن مزيدًا من القهوة.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "computer.098", "text": "هل جربت شرح المشكلة لبطة مطاطية لديها خبرة إدارية؟", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.099", "text": "إعادة هيكلة أخرى وقد يكتسب المشروع وعيًا ذاتيًا.", "category": "computer", "tone": "unhinged", "weight": 3 },
    { "id": "computer.100", "text": "حان وقت التفكير فيما إذا كنت تحتاج فعلًا ميزة أخرى.", "category": "computer", "tone": "cheeky", "weight": 3 }
  ]
}
