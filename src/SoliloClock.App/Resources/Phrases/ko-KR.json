{
  "locale": "ko-KR",
  "phrases": [
    { "id": "computer.001", "text": "또 한 번의 15분이 성공적으로 컴파일됐습니다. 당신 프로젝트와는 다르게요.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.002", "text": "컴파일러가 안부를 전합니다. 대부분 경고입니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.003", "text": "시간은 날아가는데, 빌드 시스템은 걷기를 좋아합니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.004", "text": "어딘가에서 세미콜론 하나가 누군가의 오후를 망치고 있습니다.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.005", "text": "탭을 열일곱 개 열었는데 답은 하나도 없습니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.006", "text": "버그가 기능으로 승진했습니다. 축하합니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.007", "text": "CPU는 당신을 믿습니다. RAM은 의심합니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.008", "text": "캐시를 지우고 효과가 있었던 척하기 좋은 날입니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.009", "text": "코드는 작동합니다. 아무것도 건드리지 마세요.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.010", "text": "기대를 껐다가 다시 켜 보셨나요?", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.011", "text": "마지막 경고는 그냥 고칠 수 있는 게 아닙니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.012", "text": "할 일 목록이 자기만의 할 일 목록을 요청했습니다.", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.013", "text": "문서는 평행 우주에서는 정확합니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.014", "text": "또 한 시간, 또 하나의 수수께끼 같은 의존성.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.015", "text": "깨끗한 빌드는 아름답고도 수상합니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.016", "text": "터미널이 잊을 수 없는 것을 봤습니다.", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.017", "text": "오늘의 예보: 산발적 예외, 롤백 가능성.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.018", "text": "탭 하나는 닫아도 됩니다. 보상으로요.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.019", "text": "디버거는 당신을 판단하지 않습니다. 아마도.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.020", "text": "미래의 당신이 이 단축키에 대해 민원을 넣었습니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.021", "text": "Git은 기억합니다. Git은 항상 기억합니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.022", "text": "이 저장소 어딘가에 final_final이라는 함수가 있습니다.", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.023", "text": "테스트가 초록색입니다. 수상할 정도로.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.024", "text": "노트북 팬이 실험적 재즈를 작곡하고 있습니다.", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.025", "text": "설정 파일을 덜 쓰는 걸 고려해 봤나요? 우리도 아니에요.", "category": "computer", "tone": "cheeky", "weight": 4 },

    { "id": "break.026", "text": "여기서 세 시간째입니다. 바깥세상이 할 말이 있대요.", "category": "break", "tone": "cheeky", "weight": 3, "minActiveMinutes": 180 },
    { "id": "break.027", "text": "의자가 당신의 동행에 만족했습니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.028", "text": "하늘은 여전히 구독 없이 이용 가능합니다.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.029", "text": "가서 나무를 보세요. 디버거는 필요 없습니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.030", "text": "눈이 정비 시간을 요청했습니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.031", "text": "짧은 산책이 머릿속 의존성을 해결할지도 모릅니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.032", "text": "잔디는 업데이트되지 않았지만 만져 볼 가치는 있습니다.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.033", "text": "물: 최초의 생산성 플러그인.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.034", "text": "기지개를 켜세요. 당신의 스택에도 한계가 있습니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.035", "text": "컴퓨터를 혼자 둬도 됩니다. 잘 견딜 겁니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.036", "text": "커피는 햇빛을 대신하지 못합니다.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.037", "text": "친절한 알림: 무릎에는 용도가 있습니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.038", "text": "화면에서 멀어지세요. 픽셀은 충직하게 남습니다.", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.039", "text": "신선한 공기는 하위 호환성이 뛰어납니다.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.040", "text": "키보드가 잠깐의 거리를 제안합니다.", "category": "break", "tone": "polite", "weight": 3 },

    { "id": "morning.041", "text": "좋은 아침입니다. 버그는 몇 시간 전에 깨어났습니다.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.042", "text": "일어나 빛나세요. 아니면 일어나 협상하세요.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.043", "text": "아침 식사는 선택적 의존성이 아닙니다.", "category": "morning", "tone": "polite", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.044", "text": "하루는 젊고, 받은편지함은 고대입니다.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.045", "text": "커피가 대화에 합류했습니다.", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },

    { "id": "afternoon.046", "text": "곧 점심시간입니다. 시계까지 배고파 보입니다.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.047", "text": "오후가 쓸모 있는 릴리스 노트 없이 도착했습니다.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.048", "text": "창문을 옮기며 보낸 또 하나의 생산적인 오전.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.049", "text": "달력은 회의라고 하고, 영혼은 절대 아니라고 합니다.", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.050", "text": "해가 최선을 다하고 있습니다. 함께해도 좋습니다.", "category": "afternoon", "tone": "polite", "weight": 3, "timeWindow": "afternoon" },

    { "id": "evening.051", "text": "저녁 근무를 이제 시계가 감독합니다.", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.052", "text": "영웅적 진전과 의심스러운 결정이었던 또 하루.", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.053", "text": "늦었습니다. 미래의 당신은 잠을 고마워할 겁니다.", "category": "evening", "tone": "polite", "weight": 3, "timeWindow": "evening" },

    { "id": "late-night.054", "text": "달이 출근했습니다. 당신은 퇴근했나요?", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.055", "text": "자정: 모든 아이디어가 스타트업처럼 들리는 시간.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.056", "text": "베개가 지원 티켓을 열었습니다.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.057", "text": "이 시간에는 변수 이름이 시가 됩니다.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.058", "text": "밤은 조용합니다. 당신의 쿨링팬만 빼고요.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.059", "text": "코드는 아침까지 기다릴 수 있습니다. 버그는 어디 가지 않습니다.", "category": "late-night", "tone": "polite", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.060", "text": "내일은 모든 이름을 바꿀 또 한 번의 기회입니다.", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },

    { "id": "fortune.061", "text": "지켜보는 진행 표시줄은 절대 패배를 인정하지 않습니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.062", "text": "시계의 지혜를 조심하세요. 항상 뭔가를 세고 있습니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.063", "text": "현명한 프로그래머는 멈출 때를 압니다. 전설은 타이머를 갖고 있습니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.064", "text": "시간은 돈이지만 이 시계는 둘 다 받지 않습니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.065", "text": "우주는 팽창합니다. 다운로드 폴더도요.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.066", "text": "시계와 다투지 마세요. 세상의 모든 시간을 갖고 있습니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.067", "text": "인생이 레몬을 준다면 패키지 체크섬부터 확인하세요.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.068", "text": "당신의 운명은 처리 중입니다. 새로고침하지 마세요.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.069", "text": "빈 받은편지함은 주니어에게 하는 신화입니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.070", "text": "행복의 비결은 설정 → 고급 어딘가에 있습니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.071", "text": "모든 위대한 발명은 다른 일을 피하던 누군가에게서 시작됐습니다.", "category": "fortune", "tone": "polite", "weight": 3 },
    { "id": "fortune.072", "text": "사람은 두 종류입니다. 백업하는 사람과 미래의 교훈.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.073", "text": "현명한 사람은 묻고, 어리석은 사람은 '모두 업데이트'를 누릅니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.074", "text": "시계는 지난여름 당신이 뭘 했는지 압니다. 아마 디버깅이겠죠.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.075", "text": "어딘가 오래된 서버가 완벽하게 돌아갑니다. 아무도 이유를 모릅니다.", "category": "fortune", "tone": "cheeky", "weight": 3 },

    { "id": "rare.076", "text": "주목. 당신의 마우스가 프로젝트 매니저로 선출됐습니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.077", "text": "이 알림은 국제 분 위원회의 승인을 받았습니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.078", "text": "시계가 즉흥 무용으로 전직하기로 했습니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.079", "text": "침착하세요. 매우 정시적인 1초가 다가옵니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.080", "text": "다음 1분은 이전 1분이 제공합니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.081", "text": "모든 초를 세었습니다. 어떤 초는 몹시 실망스러웠습니다.", "category": "rare", "tone": "unhinged", "weight": 1 },
    { "id": "rare.082", "text": "책상이 성과 평가를 요청했습니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.083", "text": "시침과 분침이 이제 말을 안 합니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.084", "text": "시간 여행 농담을 하려 했는데 당신이 싫어했죠.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.085", "text": "시계로 구성된 작은 위원회가 화요일 연기를 의결했습니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.086", "text": "초들이 노조를 만들고 있습니다. 지연을 예상하세요.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.087", "text": "전설의 업적을 달성했습니다: 아직 여기 앉아 있음.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.088", "text": "유감스럽게도 내일은 취소되지 않았습니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.089", "text": "'시간 엄수'라는 개념은 현재 베타입니다.", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.090", "text": "시계가 당신의 계속된 존재에 감사합니다.", "category": "rare", "tone": "cheeky", "weight": 1 },

    { "id": "computer.091", "text": "화면을 너무 오래 봐서 배경화면이 될 것 같습니다.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.092", "text": "이게 마지막 수정인 척하는 또 15분.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.093", "text": "당신의 생산성 그래프가 어깨 으쓱으로 대체됐습니다.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.094", "text": "이건 시계지 라이프 코치가 아닙니다. 그래도 뭐.", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "computer.095", "text": "아무도 알아채지 못할 것들을 최적화하는 걸 그만둬도 됩니다.", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.096", "text": "버그가 코드에 없을지도 모릅니다. 버그가 운명일지도요.", "category": "fortune", "tone": "unhinged", "weight": 3 },
    { "id": "break.097", "text": "당신의 멋진 계획에는 커피가 더 필요한 것 같습니다.", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "computer.098", "text": "관리 경험이 있는 고무 오리에게 문제를 설명해 봤나요?", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.099", "text": "리팩터링을 한 번 더 하면 프로젝트가 자의식을 얻을지도 모릅니다.", "category": "computer", "tone": "unhinged", "weight": 3 },
    { "id": "computer.100", "text": "이제 정말 새 기능이 필요했는지 생각할 시간입니다.", "category": "computer", "tone": "cheeky", "weight": 3 }
  ]
}
