{
  "locale": "ja-JP",
  "phrases": [
    { "id": "computer.001", "text": "また十五分がビルドに成功しました。あなたのプロジェクトとは違って。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.002", "text": "コンパイラがよろしくと言っています。ほとんど警告です。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.003", "text": "時間は飛ぶのに、ビルドシステムは歩くのがお好き。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.004", "text": "どこかでセミコロンが誰かの午後を台無しにしています。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.005", "text": "タブを十七個開いて、答えはゼロ。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.006", "text": "バグが機能に昇格しました。おめでとうございます。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.007", "text": "CPU はあなたを信じています。メモリは疑っています。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.008", "text": "キャッシュを消して効果があったふりをするのに良い日です。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.009", "text": "コードは動いています。何も触らないでください。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.010", "text": "期待を一度電源オフにして、また入れてみましたか？", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.011", "text": "最後の警告は、さっと直せるものではありません。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.012", "text": "あなたの ToDo リストが自分の ToDo リストを要求しました。", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.013", "text": "ドキュメントは並行宇宙では正確です。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.014", "text": "また一時間、また謎の依存関係。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.015", "text": "クリーンビルドは美しく、そして怪しい。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.016", "text": "ターミナルは二度と忘れられないものを見ました。", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.017", "text": "今日の予報：散発的な例外、巻き戻しの可能性あり。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.018", "text": "タブを一つ閉じてもいいですよ。ご褒美に。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.019", "text": "デバッガーはあなたを裁いていません。たぶん。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.020", "text": "未来のあなたがこのショートカットについて苦情を出しました。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.021", "text": "Git は覚えています。Git はいつも覚えています。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.022", "text": "このリポジトリのどこかに final_final という関数があります。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.023", "text": "テストは緑です。怪しいほど緑です。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.024", "text": "ノート PC のファンが実験的ジャズを作曲中です。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.025", "text": "設定ファイルを減らそうと考えたことは？私たちもありません。", "category": "computer", "tone": "cheeky", "weight": 4 },

    { "id": "break.026", "text": "もう三時間ここにいます。外の世界が話したいそうです。", "category": "break", "tone": "cheeky", "weight": 3, "minActiveMinutes": 180 },
    { "id": "break.027", "text": "椅子はあなたの相手に満足しました。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.028", "text": "空は今もサブスクなしで利用できます。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.029", "text": "木を見に行きましょう。デバッガーは不要です。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.030", "text": "あなたの目がメンテナンス時間を申請しました。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.031", "text": "短い散歩が頭の中の依存関係を解決するかもしれません。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.032", "text": "草は更新されていませんが、触る価値はあります。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.033", "text": "水：元祖の生産性プラグイン。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.034", "text": "伸びをしましょう。あなたのスタックにも限界があります。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.035", "text": "パソコンを放置しても大丈夫です。なんとかします。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.036", "text": "コーヒーは日光の代わりになりません。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.037", "text": "親切な注意：膝には役割があります。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.038", "text": "画面から離れてください。ピクセルは忠実なままです。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.039", "text": "新鮮な空気は後方互換性が抜群です。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.040", "text": "キーボードが少しの距離を提案しています。", "category": "break", "tone": "polite", "weight": 3 },

    { "id": "morning.041", "text": "おはようございます。バグは何時間も前に起きています。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.042", "text": "起きて輝きましょう。あるいは起きて交渉しましょう。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.043", "text": "朝食はオプションの依存関係ではありません。", "category": "morning", "tone": "polite", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.044", "text": "一日は若い。受信箱は古代です。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.045", "text": "コーヒーが会話に参加しました。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },

    { "id": "afternoon.046", "text": "もうすぐ昼食です。時計までお腹を空かせています。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.047", "text": "午後が役に立つリリースノートなしでやってきました。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.048", "text": "また窓を動かす生産的な午前でした。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.049", "text": "カレンダーは会議と言います。魂は絶対に嫌だと言います。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.050", "text": "太陽はがんばっています。仲間に入ってもいいですよ。", "category": "afternoon", "tone": "polite", "weight": 3, "timeWindow": "afternoon" },

    { "id": "evening.051", "text": "夜勤は今、時計が見張っています。", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.052", "text": "英雄的な進歩と怪しい決断の、また一日。", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.053", "text": "夜も更けました。未来のあなたは睡眠に感謝するでしょう。", "category": "evening", "tone": "polite", "weight": 3, "timeWindow": "evening" },

    { "id": "late-night.054", "text": "月が出勤しました。あなたは退勤しましたか？", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.055", "text": "真夜中：すべてのアイデアがスタートアップに聞こえる時間。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.056", "text": "枕がサポートチケットを開きました。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.057", "text": "この時間、変数名は詩になります。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.058", "text": "夜は静かです。あなたの冷却ファン以外は。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.059", "text": "コードは朝まで待てます。バグはどこにも行きません。", "category": "late-night", "tone": "polite", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.060", "text": "明日はすべてを改名するもう一つの機会です。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },

    { "id": "fortune.061", "text": "見つめているプログレスバーは決して負けを認めません。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.062", "text": "時計の知恵に注意。いつも何かを数えています。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.063", "text": "賢いプログラマーはやめる時を知っています。伝説はタイマーを持っています。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.064", "text": "時は金なり。ただしこの時計はどちらも受け取りません。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.065", "text": "宇宙は膨張しています。ダウンロードフォルダも。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.066", "text": "時計と口論しないでください。世界の時間を全部持っています。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.067", "text": "人生がレモンをくれたら、パッケージのチェックサムを確認しましょう。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.068", "text": "あなたの運命は処理中です。更新しないでください。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.069", "text": "空の受信箱は新人に語られる神話です。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.070", "text": "幸せの秘訣は「設定 → 詳細」のどこかにあります。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.071", "text": "すべての偉大な発明は、別の作業を避けた誰かから始まりました。", "category": "fortune", "tone": "polite", "weight": 3 },
    { "id": "fortune.072", "text": "人間は二種類：バックアップを取る人と、未来の教訓。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.073", "text": "賢い人は問い、愚かな人は「すべて更新」を押します。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.074", "text": "時計は去年の夏あなたが何をしたか知っています。たぶんデバッグです。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.075", "text": "どこかで古いサーバーが完璧に動いています。誰も理由を知りません。", "category": "fortune", "tone": "cheeky", "weight": 3 },

    { "id": "rare.076", "text": "注目。あなたのマウスがプロジェクトマネージャーに選ばれました。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.077", "text": "このアナウンスは国際分委員会の承認を受けています。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.078", "text": "時計は即興ダンスに転職することにしました。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.079", "text": "落ち着いてください。非常に正確な一秒が近づいています。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.080", "text": "次の一分は前の一分の提供です。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.081", "text": "すべての秒を数えました。いくつかは深く失望させられました。", "category": "rare", "tone": "unhinged", "weight": 1 },
    { "id": "rare.082", "text": "机が人事評価を要求しました。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.083", "text": "時針と分針はもう口をきいていません。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.084", "text": "タイムトラベルの冗談を言おうとしましたが、気に入られませんでした。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.085", "text": "時計の小さな委員会が火曜日の延期を可決しました。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.086", "text": "秒たちが労働組合を作っています。遅れが見込まれます。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.087", "text": "伝説の実績を解除しました：まだここに座っている。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.088", "text": "残念なお知らせです。明日は中止されていません。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.089", "text": "「時間厳守」という概念は現在ベータ版です。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.090", "text": "時計はあなたが存在し続けてくれたことに感謝します。", "category": "rare", "tone": "cheeky", "weight": 1 },

    { "id": "computer.091", "text": "画面を見つめる時間が長すぎて、壁紙になりそうです。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.092", "text": "また十五分、これが最後の修正だというふり。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.093", "text": "生産性のグラフが肩をすくめる動作に置き換えられました。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.094", "text": "これは時計で、ライフコーチではありません。でも、まあ。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "computer.095", "text": "誰も気づかないものを最適化するのをやめてもいいんですよ。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.096", "text": "バグはコードにないのかもしれません。バグが運命なのかも。", "category": "fortune", "tone": "unhinged", "weight": 3 },
    { "id": "break.097", "text": "あなたの素晴らしい計画には、もっとコーヒーが必要なようです。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "computer.098", "text": "経営経験のあるゴム製のアヒルに問題を説明してみましたか？", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.099", "text": "もう一回リファクタリングすれば、プロジェクトは自我を持つかもしれません。", "category": "computer", "tone": "unhinged", "weight": 3 },
    { "id": "computer.100", "text": "そろそろ、本当に新機能が必要だったのか考える時間です。", "category": "computer", "tone": "cheeky", "weight": 3 }
  ]
}
