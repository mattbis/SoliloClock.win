{
  "locale": "zh-Hant",
  "phrases": [
    { "id": "computer.001", "text": "又一個十五分鐘編譯成功了。你的專案可不一定。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.002", "text": "你的編譯器向你問好。主要是警告。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.003", "text": "時間在飛。你的建置系統比較喜歡走路。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.004", "text": "某個地方，一個分號正在毀掉別人的下午。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.005", "text": "你開了十七個分頁，卻一個答案也沒有。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.006", "text": "這個 bug 已經升格成功能了。恭喜。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.007", "text": "你的 CPU 相信你。你的記憶體有些疑慮。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.008", "text": "天氣真好，適合清一下快取然後假裝有用。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.009", "text": "程式碼能跑。請什麼都別碰。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.010", "text": "你試過把期望關掉再打開嗎？", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.011", "text": "最後一個警告，是沒辦法隨手修好的。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.012", "text": "你的待辦清單申請了它自己的待辦清單。", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.013", "text": "文件在平行宇宙裡是準確的。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.014", "text": "又一個小時，又一個神祕相依套件。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.015", "text": "一次乾淨的建置，既美好又可疑。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.016", "text": "你的終端機見過一些再也忘不掉的東西。", "category": "computer", "tone": "unhinged", "weight": 4 },
    { "id": "computer.017", "text": "今日預報：零星例外，可能有回滾。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.018", "text": "你可以關掉一個分頁。就當作獎勵。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.019", "text": "偵錯工具沒有在評判你。大概吧。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.020", "text": "未來的你已經就這個捷徑提出了申訴。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.021", "text": "Git 記得。Git 永遠記得。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.022", "text": "這個儲存庫裡某處有個叫 final_final 的函式。", "category": "computer", "tone": "polite", "weight": 4 },
    { "id": "computer.023", "text": "測試全綠。綠得可疑。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.024", "text": "你的筆電風扇正在創作實驗爵士。", "category": "computer", "tone": "cheeky", "weight": 4 },
    { "id": "computer.025", "text": "你考慮過少寫點設定檔嗎？我們也沒有。", "category": "computer", "tone": "cheeky", "weight": 4 },

    { "id": "break.026", "text": "你已經在這兒三個小時了。外面的世界想聊兩句。", "category": "break", "tone": "cheeky", "weight": 3, "minActiveMinutes": 180 },
    { "id": "break.027", "text": "你的椅子已經受夠你的陪伴了。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.028", "text": "天空依然免費開放，不用訂閱。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.029", "text": "去看看一棵樹吧。不需要偵錯工具。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.030", "text": "你的眼睛申請了一個維護時段。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.031", "text": "散個短步，也許能解決腦子裡的相依關係。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.032", "text": "草沒有更新，但仍然值得摸一摸。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.033", "text": "水：最原始的生產力外掛。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.034", "text": "伸個懶腰。連你的堆疊都有極限。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.035", "text": "你可以讓電腦獨處一會兒。它應付得來。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.036", "text": "咖啡不能代替日光。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.037", "text": "友情提醒：膝蓋是有用途的。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.038", "text": "離螢幕遠一點。像素會保持忠誠。", "category": "break", "tone": "polite", "weight": 3 },
    { "id": "break.039", "text": "新鮮空氣的向後相容性極好。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "break.040", "text": "你的鍵盤建議短暫分離。", "category": "break", "tone": "polite", "weight": 3 },

    { "id": "morning.041", "text": "早安。bug 已經醒了好幾個小時。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.042", "text": "起床發光吧。或者起床談判。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.043", "text": "早餐不是可有可無的相依項目。", "category": "morning", "tone": "polite", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.044", "text": "一天還年輕。你的收件匣已經很古老了。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },
    { "id": "morning.045", "text": "咖啡加入了對話。", "category": "morning", "tone": "cheeky", "weight": 3, "timeWindow": "morning" },

    { "id": "afternoon.046", "text": "快到午飯時間了。連時鐘看起來都餓了。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.047", "text": "下午到了，沒有附上任何有用的版本說明。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.048", "text": "又一個搬視窗搬到很有成就感的上午。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.049", "text": "行事曆說開會。靈魂說絕對不行。", "category": "afternoon", "tone": "cheeky", "weight": 3, "timeWindow": "afternoon" },
    { "id": "afternoon.050", "text": "太陽已經很努力了。你也可以加入它。", "category": "afternoon", "tone": "polite", "weight": 3, "timeWindow": "afternoon" },

    { "id": "evening.051", "text": "晚班現在由一隻時鐘監督。", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.052", "text": "又一個英勇進展與可疑決定並存的日子。", "category": "evening", "tone": "cheeky", "weight": 3, "timeWindow": "evening" },
    { "id": "evening.053", "text": "夜深了。未來的你會感謝現在的睡眠。", "category": "evening", "tone": "polite", "weight": 3, "timeWindow": "evening" },

    { "id": "late-night.054", "text": "月亮來打卡了。你打卡下班了嗎？", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.055", "text": "午夜：每個想法聽起來都像新創公司。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.056", "text": "你的枕頭提交了支援工單。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.057", "text": "這個時辰，變數名稱都變成了詩。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.058", "text": "夜裡很安靜。除了你的散熱風扇。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.059", "text": "程式碼可以等到早上。bug 哪裡也不會去。", "category": "late-night", "tone": "polite", "weight": 3, "timeWindow": "late-night" },
    { "id": "late-night.060", "text": "明天又是把所有東西改名的一次機會。", "category": "late-night", "tone": "cheeky", "weight": 3, "timeWindow": "late-night" },

    { "id": "fortune.061", "text": "盯著看的進度條從不認輸。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.062", "text": "小心時鐘的智慧：它們總在盤算著什麼。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.063", "text": "聰明的程式設計師知道何時停手。傳奇的程式設計師有計時器。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.064", "text": "時間就是金錢，但這只時鐘兩樣都不收。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.065", "text": "宇宙在膨脹。你的下載資料夾也是。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.066", "text": "別跟時鐘爭。它擁有全世界的時間。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.067", "text": "如果生活給你檸檬，先檢查一下壓縮檔的校驗碼。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.068", "text": "你的命運正在處理中。請不要重新整理。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.069", "text": "收件匣空空，是講給初階開發者的神話。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.070", "text": "幸福的祕訣在「設定 → 進階」裡的某個地方。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.071", "text": "每一項偉大發明，都始於某個人在躲另一件事。", "category": "fortune", "tone": "polite", "weight": 3 },
    { "id": "fortune.072", "text": "有兩種人：做備份的，和未來的反面教材。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.073", "text": "聰明人提問。愚蠢的人點「全部更新」。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.074", "text": "時鐘知道你去年夏天做了什麼。大概是在除錯。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.075", "text": "某個地方，一台老伺服器依然運作完美。沒人知道為什麼。", "category": "fortune", "tone": "cheeky", "weight": 3 },

    { "id": "rare.076", "text": "注意。你的滑鼠被選為專案經理了。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.077", "text": "這則播報已獲國際分鐘委員會核准。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.078", "text": "時鐘決定轉行去跳即興舞。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.079", "text": "請保持冷靜。一個格外準時的秒正在接近。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.080", "text": "下一分鐘由上一分鐘贊助。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.081", "text": "我數過每一秒。其中一些非常令人失望。", "category": "rare", "tone": "unhinged", "weight": 1 },
    { "id": "rare.082", "text": "你的桌子要求做績效評估。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.083", "text": "時針和分針已經互不說話了。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.084", "text": "我本想講個時空旅行的笑話，可是你不喜歡。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.085", "text": "一個小型時鐘委員會投票決定延後星期二。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.086", "text": "秒們正在組工會。預計會有延遲。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.087", "text": "你解鎖了傳奇成就：還坐在這裡。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.088", "text": "很遺憾通知你，明天並沒有取消。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.089", "text": "「準時」這個概念目前還在測試版。", "category": "rare", "tone": "cheeky", "weight": 1 },
    { "id": "rare.090", "text": "時鐘感謝你繼續存在。", "category": "rare", "tone": "cheeky", "weight": 1 },

    { "id": "computer.091", "text": "你盯著螢幕的時間，足夠變成一張桌布了。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.092", "text": "又十五分鐘，假裝這是最後一次修改。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.093", "text": "你的生產力曲線被一個聳肩取代了。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.094", "text": "這是時鐘，不是人生教練。不過話說回來。", "category": "fortune", "tone": "cheeky", "weight": 3 },
    { "id": "computer.095", "text": "你獲准停止最佳化沒人會注意的東西。", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "fortune.096", "text": "也許 bug 不在程式碼裡。也許 bug 就是命運。", "category": "fortune", "tone": "unhinged", "weight": 3 },
    { "id": "break.097", "text": "你的絕妙計畫似乎需要更多咖啡。", "category": "break", "tone": "cheeky", "weight": 3 },
    { "id": "computer.098", "text": "你試過向一隻有管理經驗的橡皮鴨解釋問題嗎？", "category": "computer", "tone": "cheeky", "weight": 3 },
    { "id": "computer.099", "text": "再重構一次，專案可能就會產生自我意識。", "category": "computer", "tone": "unhinged", "weight": 3 },
    { "id": "computer.100", "text": "現在該想想，你是不是真的需要又一個功能。", "category": "computer", "tone": "cheeky", "weight": 3 }
  ]
}
