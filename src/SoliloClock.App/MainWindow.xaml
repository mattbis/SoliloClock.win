<Window x:Class="SoliloClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoliloClock.Controls"
        Style="{StaticResource ClockWindowStyle}"
        Title="{Binding Strings.AppName}"
        Language="{Binding WpfLanguage}"
        FlowDirection="{Binding FlowDirection}"
        Width="380"
        Height="660"
        MinWidth="320"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop, Mode=TwoWay}"
        Opacity="{Binding EffectiveWindowOpacity}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Border x:Name="RootBorder"
          CornerRadius="26"
          Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource WindowBorderBrush}"
          BorderThickness="1"
          Padding="18,10,18,14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28"
                        ShadowDepth="0"
                        Opacity="0.55"
                        Color="{DynamicResource ShadowColor}" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="Transparent" Margin="2,0,0,2"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Strings.BrandTitle}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource WindowButtonStyle}"
                  Content="—"
                  Click="Minimize_Click"
                  ToolTip="{Binding Strings.HideToTray}"
                  AutomationProperties.Name="{Binding Strings.HideToTray}" />
          <Button Style="{StaticResource WindowButtonStyle}"
                  Content="✕"
                  Click="Close_Click"
                  ToolTip="{Binding Strings.CloseToTray}"
                  AutomationProperties.Name="{Binding Strings.CloseToTray}" />
        </StackPanel>
      </Grid>

      <controls:AnalogClock Grid.Row="1"
                            x:Name="Clock"
                            Margin="0,4,0,0"
                            MaxHeight="300"
                            FaceBrush="{DynamicResource ClockFaceBrush}"
                            RimBrush="{DynamicResource ClockRimBrush}"
                            TickMajorBrush="{DynamicResource TickMajorBrush}"
                            TickMinorBrush="{DynamicResource TickMinorBrush}"
                            HourHandBrush="{DynamicResource HourHandBrush}"
                            MinuteHandBrush="{DynamicResource MinuteHandBrush}"
                            SecondHandBrush="{DynamicResource SecondHandBrush}"
                            AccentBrush="{DynamicResource AccentBrush}"
                            GlowBrush="{DynamicResource GlowBrush}"
                            NumeralBrush="{DynamicResource TextPrimaryBrush}"
                            FontFamily="{DynamicResource ClockFontFamilyResource}"
                            ReducedMotion="{Binding ReducedMotion}"
                            Sparkles="{Binding Sparkles}"
                            Glow="{Binding Glow}"
                            AutomationProperties.Name="{Binding Strings.AnalogClockName}" />

      <StackPanel Grid.Row="2" Margin="0,4,0,0">
        <TextBlock Text="{Binding DigitalTime}"
                   FontSize="26"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontFamily="{DynamicResource ClockFontFamilyResource}" />
        <TextBlock Text="{Binding NextAnnouncementText}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <TextBlock Text="{Binding Strings.IntervalHeading}"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Margin="4,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <UniformGrid Columns="4">
          <RadioButton Style="{StaticResource IntervalRadioStyle}"
                       GroupName="Interval"
                       Content="15"
                       IsChecked="{Binding IsInterval15, Mode=OneWay}"
                       Command="{Binding SelectIntervalCommand}"
                       CommandParameter="15"
                       ToolTip="{Binding Strings.Interval15Tooltip}"
                       AutomationProperties.Name="{Binding Strings.Interval15Tooltip}" />
          <RadioButton Style="{StaticResource IntervalRadioStyle}"
                       GroupName="Interval"
                       Content="30"
                       IsChecked="{Binding IsInterval30, Mode=OneWay}"
                       Command="{Binding SelectIntervalCommand}"
                       CommandParameter="30"
                       ToolTip="{Binding Strings.Interval30Tooltip}"
                       AutomationProperties.Name="{Binding Strings.Interval30Tooltip}" />
          <RadioButton Style="{StaticResource IntervalRadioStyle}"
                       GroupName="Interval"
                       Content="45"
                       IsChecked="{Binding IsInterval45, Mode=OneWay}"
                       Command="{Binding SelectIntervalCommand}"
                       CommandParameter="45"
                       ToolTip="{Binding Strings.Interval45Tooltip}"
                       AutomationProperties.Name="{Binding Strings.Interval45Tooltip}" />
          <RadioButton Style="{StaticResource IntervalRadioStyle}"
                       GroupName="Interval"
                       Content="60"
                       IsChecked="{Binding IsInterval60, Mode=OneWay}"
                       Command="{Binding SelectIntervalCommand}"
                       CommandParameter="60"
                       ToolTip="{Binding Strings.Interval60Tooltip}"
                       AutomationProperties.Name="{Binding Strings.Interval60Tooltip}" />
        </UniformGrid>
      </StackPanel>

      <Grid Grid.Row="4" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0"
                      Style="{StaticResource IconToggleStyle}"
                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                      ToolTip="{Binding MuteTooltip}"
                      AutomationProperties.Name="{Binding MuteTooltip}">
          <TextBlock FontFamily="Segoe MDL2 Assets"
                     FontSize="18"
                     Text="{Binding MuteGlyph}" />
        </ToggleButton>

        <Button Grid.Column="1"
                Margin="8,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Content="{Binding Strings.SpeakNow}"
                Command="{Binding SpeakNowCommand}"
                AutomationProperties.Name="{Binding Strings.SpeakNowAutomation}" />

        <Button Grid.Column="2"
                Style="{StaticResource SecondaryButtonStyle}"
                Content="{Binding ThemeDisplayName}"
                Command="{Binding CycleThemeCommand}"
                MaxWidth="112"
                ToolTip="{Binding Strings.ChangeTheme}"
                AutomationProperties.Name="{Binding Strings.ChangeTheme}" />

        <ToggleButton Grid.Column="3"
                      Margin="8,0,0,0"
                      Style="{StaticResource IconToggleStyle}"
                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                      ToolTip="{Binding Strings.AlwaysOnTop}"
                      AutomationProperties.Name="{Binding Strings.AlwaysOnTop}">
          <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE718;" />
        </ToggleButton>
      </Grid>

      <StackPanel Grid.Row="5"
                  Margin="0,10,0,0"
                  Visibility="{Binding IsTransparentTheme, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <TextBlock Text="{Binding Strings.WindowOpacity}"
                     FontSize="10"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding WindowOpacity, StringFormat={}{0:P0}}"
                     FontSize="10"
                     HorizontalAlignment="Right"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
        <Slider Style="{StaticResource OpacitySliderStyle}"
                Minimum="0.45"
                Maximum="1"
                SmallChange="0.01"
                LargeChange="0.05"
                Value="{Binding WindowOpacity, Mode=TwoWay}"
                AutomationProperties.Name="{Binding Strings.WindowOpacity}" />
      </StackPanel>

      <Border Grid.Row="6"
              Margin="0,12,0,0"
              MinHeight="56"
              CornerRadius="14"
              Padding="12,8"
              Background="{DynamicResource SurfaceBrush}">
        <TextBlock x:Name="CaptionText"
                   Text="{Binding Caption}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="12"
                   FontStyle="Italic"
                   Foreground="{DynamicResource CaptionBrush}"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding Strings.LastSpokenName}" />
      </Border>

      <TextBlock Grid.Row="7"
                 Text="{Binding Status}"
                 FontSize="10"
                 TextWrapping="Wrap"
                 MaxHeight="30"
                 Margin="3,8,3,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <TextBlock Grid.Row="8"
                 Text="{Binding Strings.FooterHint}"
                 FontSize="9"
                 Margin="0,6,0,0"
                 HorizontalAlignment="Center"
                 Opacity="0.7"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
  </Border>
</Window>
